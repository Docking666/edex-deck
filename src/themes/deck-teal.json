{
    "colors": {
        "r": 0,
        "g": 168,
        "b": 128,
        "black": "#000000",
        "light_black": "#1C1C1E",
        "grey": "#2E2E33",
        "red": "#E5484D",
        "green": "#00BC90",
        "yellow": "#E5C18C",
        "blue": "#4C7DD6",
        "magenta": "#A78BFA",
        "cyan": "#5FE5D0",
        "white": "#D2D3E0",
        "brightBlack": "#4C4F6B",
        "brightRed": "#FF6369",
        "brightGreen": "#2EE6B0",
        "brightYellow": "#FFD9A0",
        "brightBlue": "#7CA8FF",
        "brightMagenta": "#C4B5FD",
